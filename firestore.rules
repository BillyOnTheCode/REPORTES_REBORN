rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function tieneSesion() {
      return request.auth != null;
    }

    function correoActual() {
      return request.auth.token.get('email', '').lower();
    }

    function correoVerificado() {
      return tieneSesion() &&
        request.auth.token.get('email_verified', false) == true;
    }

    function esCorreoInspectorMayor() {
      return tieneSesion() &&
        correoActual() == 'rodrigo.rojas.arbayza@alumnos.sip.cl';
    }

    function esInspectorMayor() {
      return correoVerificado() && esCorreoInspectorMayor();
    }

    function rolDeLaCuenta() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '');
    }

    function esInspector() {
      return correoVerificado() && (
        esInspectorMayor() ||
        rolDeLaCuenta() == 'inspector' ||
        rolDeLaCuenta() == 'inspector_mayor'
      );
    }

    function rolNormal(correo) {
      return correo.lower().matches('.*@sip\\.cl$') ? 'profesor' : 'alumno';
    }

    function tipoDeLaCuenta() {
      let rol = rolDeLaCuenta();
      return rol == 'profesor' ? 'profesor' :
        rol == 'alumno' ? 'alumno' : rolNormal(correoActual());
    }

    function puedeVerImagen(reporteId) {
      let reporte = get(/databases/$(database)/documents/reportes/$(reporteId));
      return esInspector() || (
        correoVerificado() && (
          reporte.data.autorUID == request.auth.uid ||
          (
            reporte.data.estado == 'aprobado' &&
            reporte.data.tipoAutor == tipoDeLaCuenta()
          )
        )
      );
    }

    function imagenPerfilValida(valor, pesoMaximo) {
      return valor is string &&
        valor.size() <= pesoMaximo &&
        (valor == '' || valor.matches('data:image/jpeg;base64,.*'));
    }

    match /usuarios/{usuarioId} {
      // cada usuario puede crear solamente su propio perfil
      allow create: if tieneSesion() &&
        request.auth.uid == usuarioId &&
        request.resource.data.correo.lower() == correoActual() &&
        (
          (esCorreoInspectorMayor() && request.resource.data.rol == 'inspector_mayor') ||
          (!esCorreoInspectorMayor() && request.resource.data.rol == rolNormal(correoActual()))
        );

      // los inspectores necesitan ver las cuentas para poder dar el rol
      allow read: if correoVerificado() && (
        request.auth.uid == usuarioId || esInspector()
      );

      // un usuario normal solo puede cambiar su apodo y su biografia
      allow update: if correoVerificado() && (
        (
          request.auth.uid == usuarioId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['username', 'bio'])
        ) ||
        puedeCambiarRol()
      );

      allow delete: if false;

      function puedeCambiarRol() {
        let cambios = request.resource.data.diff(resource.data).affectedKeys();
        let correoCuenta = resource.data.correo.lower();
        let rolAnterior = resource.data.get('rol', rolNormal(correoCuenta));
        let rolNuevo = request.resource.data.rol;

        return cambios.hasOnly(['rol']) && (
          (
            esInspectorMayor() &&
            correoCuenta != 'rodrigo.rojas.arbayza@alumnos.sip.cl' &&
            (
              rolNuevo == 'inspector' ||
              rolNuevo == rolNormal(correoCuenta) ||
              (
                rolAnterior in ['alumno', 'profesor'] &&
                rolNuevo in ['alumno', 'profesor']
              )
            )
          ) ||
          (
            !esInspectorMayor() &&
            esInspector() &&
            rolAnterior != 'inspector' &&
            rolAnterior != 'inspector_mayor' &&
            rolNuevo == 'inspector'
          )
        );
      }
    }

    match /perfilesImagenes/{usuarioId} {
      // estas imagenes estan separadas para no pesar en la lista de cuentas
      allow read: if correoVerificado() && (
        request.auth.uid == usuarioId || esInspector()
      );

      allow create, update: if correoVerificado() &&
        request.auth.uid == usuarioId &&
        request.resource.data.keys().hasOnly(['avatar', 'banner']) &&
        imagenPerfilValida(request.resource.data.avatar, 65000) &&
        imagenPerfilValida(request.resource.data.banner, 120000);

      allow delete: if correoVerificado() && request.auth.uid == usuarioId;
    }

    match /reportes/{reporteId} {
      // cada grupo puede ver los aprobados de su tipo y sus propios reportes
      allow read: if esInspector() || (
        correoVerificado() && (
          resource.data.autorUID == request.auth.uid ||
          (
            resource.data.estado == 'aprobado' &&
            resource.data.tipoAutor == tipoDeLaCuenta()
          )
        )
      );

      // todos los reportes nuevos tienen que empezar pendientes
      allow create: if correoVerificado() &&
        request.resource.data.autorUID == request.auth.uid &&
        request.resource.data.tipoAutor == tipoDeLaCuenta() &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.prioridad == 'sin_asignar' &&
        request.resource.data.get('cantidadImagenes', 0) >= 0 &&
        request.resource.data.get('cantidadImagenes', 0) <= 3 &&
        request.resource.data.get('miniatura', '') is string &&
        request.resource.data.get('miniatura', '').size() <= 50000 &&
        (
          request.resource.data.get('miniatura', '') == '' ||
          request.resource.data.get('miniatura', '').matches('data:image/jpeg;base64,.*')
        ) &&
        (
          (
            request.resource.data.tipoAutor == 'profesor' &&
            request.resource.data.anonimo == true &&
            request.resource.data.autorNombre == null &&
            request.resource.data.autorUsername == null &&
            request.resource.data.autorFotoUrl == null &&
            request.resource.data.autorCorreo == null
          ) ||
          (
            request.resource.data.tipoAutor == 'alumno' &&
            request.resource.data.autorCorreo is string &&
            request.resource.data.autorCorreo.lower() == correoActual() &&
            (
              (
                request.resource.data.anonimo == true &&
                request.resource.data.autorFotoUrl == null
              ) ||
              (
                request.resource.data.anonimo == false &&
                (
                  request.resource.data.autorFotoUrl == null ||
                  imagenPerfilValida(request.resource.data.autorFotoUrl, 65000)
                )
              )
            )
          )
        );

      // los inspectores solo cambian los datos de la revision
      allow update: if (
        esInspector() &&
          resource.data.get('estado', 'pendiente') == 'pendiente' &&
          request.resource.data.estado in ['aprobado', 'descartado'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'categoria',
            'prioridad',
            'estado',
            'revisadoPor',
            'revisadoCorreo',
            'revisadoEn'
          ])
        ) || (
          correoVerificado() &&
          resource.data.autorUID == request.auth.uid &&
          resource.data.anonimo == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autorFotoUrl']) &&
          imagenPerfilValida(request.resource.data.autorFotoUrl, 65000)
        );

      // los inspectores pueden limpiar reportes de prueba o que ya no sirven
      allow delete: if esInspector();

      match /imagenes/{imagenId} {
        // el autor y los inspectores pueden verlas, despues de aprobar todos pueden
        allow read: if puedeVerImagen(reporteId);

        // los nombres fijos evitan que alguien guarde mas de tres imagenes
        allow create: if correoVerificado() &&
          imagenId in ['imagen_0', 'imagen_1', 'imagen_2'] &&
          get(/databases/$(database)/documents/reportes/$(reporteId)).data.autorUID == request.auth.uid &&
          get(/databases/$(database)/documents/reportes/$(reporteId)).data.estado == 'pendiente' &&
          request.resource.data.keys().hasOnly([
            'nombre',
            'tipo',
            'datos',
            'posicion',
            'autorUID'
          ]) &&
          request.resource.data.autorUID == request.auth.uid &&
          request.resource.data.tipo == 'image/jpeg' &&
          request.resource.data.datos is string &&
          request.resource.data.datos.matches('data:image/jpeg;base64,.*') &&
          request.resource.data.datos.size() <= 230000 &&
          request.resource.data.nombre is string &&
          request.resource.data.nombre.size() <= 120 &&
          request.resource.data.posicion is int &&
          request.resource.data.posicion >= 0 &&
          request.resource.data.posicion <= 2;

        allow update: if false;
        allow delete: if esInspector();
      }
    }
  }
}
